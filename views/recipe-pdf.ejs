<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= recipe.name %> | Recipe PDF</title>
  <style>
    /* === Print‑friendly recipe styling === */
    :root {
      --page-width: 210mm;
      --background: #fff;
      --text-color: #1a1a1a;
      --text-muted: #4f4f4f;
      --heading-color: #2c2c2c;
      --accent: #8b6b4a;
      --ingredient-note-color: #898989;
      --border-color: #d4d4d4;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      height: 100%;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--background);
      font-family: "Georgia", "Times New Roman", serif;
      color: var(--text-color);
      line-height: 1.6;
    }

    .recipe-pdf {
      max-width: var(--page-width);
      margin: 0 auto;
      background: var(--background);
      display: flex;
      flex-direction: column;
      height: 100%;
      box-sizing: border-box;
    }

    .content-wrapper {
      flex: 1;
    }

    .recipe-header {
      text-align: center;
      margin-bottom: 18px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border-color);
    }

    .recipe-header.has-image {
      display: flex;
      text-align: left;
      gap: 20px;
      align-items: center;
    }

    .header-image {
      width: 120px;
      height: 120px;
      object-fit: contain;
      border-radius: 6px;
      flex-shrink: 0;
    }

    .header-info {
      flex: 1;
    }

    .recipe-header h1 {
      font-size: 28px;
      font-weight: 400;
      letter-spacing: 0.02em;
      color: var(--heading-color);
      margin-bottom: 4px;
    }

    .recipe-header .meta-line {
      font-size: 13px;
      color: var(--text-muted);
      display: flex;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .icon-svg {
      display: inline-flex;
      vertical-align: middle;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      margin-right: 4px;
      margin-top: -2px;
    }

    .icon-svg svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
      stroke: none;
    }

    .meta-line span {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .tag {
      display: inline-block;
      background: transparent;
      color: var(--accent);
      border: 1px solid var(--accent);
      font-size: 11px;
      padding: 1px 10px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
    }

    .tag-row {
      margin-top: 12px;
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .recipe-header.has-image .meta-line,
    .recipe-header.has-image .tag-row {
      justify-content: flex-start;
    }

    .description {
      font-style: italic;
      font-size: 14px;
      color: var(--text-muted);
      text-align: center;
      margin-bottom: 16px;
      padding: 0 10px;
      line-height: 1.5;
    }

    .ingredients-section {
      margin-bottom: 14px;
    }

    .ingredients-section h2 {
      font-size: 16px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--heading-color);
      margin-bottom: 8px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 4px;
    }

    .ingredients-table {
      width: 100%;
      border-collapse: collapse;
    }

    .ingredients-table td {
      vertical-align: top;
      padding: 0 12px;
    }

    .ingredients-table ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .ingredients-table ul li {
      font-size: 13.5px;
      padding: 3px 8px 3px 20px;
      position: relative;
      line-height: 1.35;
    }

    .ingredients-table ul li::before {
      content: "\2022";
      position: absolute;
      left: 0;
      color: var(--accent);
      font-weight: bold;
    }

    .ingredients-table ul li .ingredient-note {
      display: block;
      font-size: 11.5px;
      color: var(--ingredient-note-color);
      line-height: 1.3;
      padding-left: 0;
      font-style: italic;
    }

    .instructions-section {
      margin-bottom: 12px;
    }

    .instructions-section h2 {
      font-size: 16px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--heading-color);
      margin-bottom: 8px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 4px;
    }

    .instructions-section ol {
      padding-left: 22px;
      margin: 0;
    }

    .instructions-section ol li {
      font-size: 13.5px;
      margin-bottom: 8px;
      line-height: 1.5;
      page-break-inside: avoid;
    }

    /* Proper indentation for Markdown lists in notes and description */
    .notes-section ul, .notes-section ol,
    .description ul, .description ol {
      padding-left: 22px;
      margin: 8px 0;
      text-align: left;
    }

    .notes-section li, .description li {
      margin-bottom: 4px;
    }

    .instructions-section img {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 10px auto;
      border-radius: 4px;
    }

    /* Support for Markdown tables and other elements in instructions */
    .instructions-section table,
    .notes-section table,
    .description table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 12px 0;
      font-size: 13px;
      page-break-inside: avoid;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      overflow: hidden;
    }

    .instructions-section th, .instructions-section td,
    .notes-section th, .notes-section td,
    .description th, .description td {
      border-bottom: 1px solid var(--border-color);
      border-right: 1px solid var(--border-color);
      padding: 8px;
      word-break: break-word;
    }

    .instructions-section tr th:last-child, .instructions-section tr td:last-child,
    .notes-section tr th:last-child, .notes-section tr td:last-child,
    .description tr th:last-child, .description tr td:last-child {
      border-right: none;
    }

    .instructions-section tr:last-child td,
    .notes-section tr:last-child td,
    .description tr:last-child td {
      border-bottom: none;
    }

    .instructions-section th,
    .notes-section th,
    .description th {
      background-color: var(--background);
      font-weight: bold;
    }

    .instructions-section li p {
      margin-bottom: 6px;
    }

    .instructions-section li p:last-child {
      margin-bottom: 0;
    }


    .notes-section {
      margin-top: 10px;
      margin-bottom: 12px;
      padding-top: 10px;
      border-top: 1px solid var(--border-color);
      font-size: 12.5px;
      color: var(--text-muted);
      font-style: italic;
    }

    .note-item {
      margin-bottom: 8px;
    }

    .notes-section h2 {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--heading-color);
      margin-bottom: 4px;
      font-style: normal;
      border-bottom: none;
    }

    .notes-section p,
    .notes-section .note-item {
      margin: 0;
      line-height: 1.45;
    }

    .recipe-footer {
      flex-shrink: 0;
      margin-top: 4px;
      padding-top: 12px;
      border-top: 1px solid var(--border-color);
      font-size: 11px;
      color: var(--text-muted);
      text-align: center;
      font-style: italic;
    }

    .page-break {
      page-break-after: always;
    }
  </style>
</head>

<body>
  <div class="recipe-pdf" style="padding: <%= options.margin || '0.5in' %>;">
    <div class="content-wrapper">
      <div class="recipe-header <%= (options.showImage && recipe.fullImageUrl) ? 'has-image' : '' %>">
        <% if (options.showImage && recipe.fullImageUrl) { %>
        <img src="<%= recipe.fullImageUrl %>" class="header-image" alt="<%= recipe.name %>">
        <% } %>
        <div class="header-info">
          <h1><%= recipe.name || 'Untitled Recipe' %></h1>
          <div class="meta-line">
            <span>
              <span class="icon-svg">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor">
                  <path d="M360-840v-80h240v80H360Zm80 440h80v-240h-80v240Zm-99.5 291.5Q275-137 226-186t-77.5-114.5Q120-366 120-440t28.5-139.5Q177-645 226-694t114.5-77.5Q406-800 480-800q62 0 119 20t107 58l56-56 56 56-56 56q38 50 58 107t20 119q0 74-28.5 139.5T734-186q-49 49-114.5 77.5T480-80q-74 0-139.5-28.5ZM678-242q82-82 82-198t-82-198q-82-82-198-82t-198 82q-82 82-82 198t82 198q82 82 198 82t198-82ZM480-440Z" />
                </svg>
              </span>
              <strong>Total Time:</strong> <%= recipe.totalTime || '—' %>
            </span>
            <span>
              <span class="icon-svg">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor">
                  <path d="M320-200h60v-270q26-8 43-28.5t17-49.5v-152q0-8-6-14t-14-6q-8 0-14 6t-6 14v100h-30v-100q0-8-6-14t-14-6q-8 0-14 6t-6 14v100h-30v-100q0-8-6-14t-14-6q-8 0-14 6t-6 14v152q0 29 17 49.5t43 28.5v270Zm240 0h60v-254q33-16 51.5-51t18.5-82q0-57-28.5-95T590-720q-43 0-71.5 38T490-587q0 47 18.5 82t51.5 51v254ZM160-80q-33 0-56.5-23.5T80-160v-640q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v640q0 33-23.5 56.5T800-80H160Zm0-80h640v-640H160v640Zm0 0v-640 640Z" />
                </svg>
              </span>
              <strong>Servings:</strong> <%= recipe.recipeServings || '—' %>
            </span>
          </div>

          <% if (locals.options && options.showTags && recipe.tags && recipe.tags.length) { %>
          <div class="tag-row">
            <% recipe.tags.forEach(function(tag) { %>
            <span class="tag"><%= tag.name %></span>
            <% }); %>
          </div>
          <% } %>
        </div>
      </div>

      <% if (recipe.description) { %>
      <div class="description"><%- recipe.description %></div>
      <% } %>

      <div class="ingredients-section">
        <h2>Ingredients</h2>
        <table class="ingredients-table">
          <tr>
            <% if (locals.ingredientColumns && ingredientColumns.length > 0) { %>
              <% ingredientColumns.forEach(function(column) { %>
                <td style="width: <%= 100 / ingredientColumns.length %>%;">
                  <ul>
                    <% column.forEach(function(ing) { %>
                    <li>
                      <%= ing.display %>
                      <% if (ing.note) { %>
                      <span class="ingredient-note"><%= ing.note %></span>
                      <% } %>
                    </li>
                    <% }); %>
                  </ul>
                </td>
              <% }); %>
            <% } else { %>
              <td><ul><li>No ingredients listed.</li></ul></td>
            <% } %>
          </tr>
        </table>
      </div>

      <div class="instructions-section">
        <h2>Instructions</h2>
        <ol>
          <% if (recipe.recipeInstructions && recipe.recipeInstructions.length) { %>
          <% recipe.recipeInstructions.forEach(function(step) { %>
          <li><%- step.text %></li>
          <% }); %>
          <% } else { %>
          <li>No instructions provided.</li>
          <% } %>
        </ol>
      </div>

    </div>

    <% if (locals.options && options.showNotes && recipe.notes && recipe.notes.length) { %>
    <div class="notes-section">
      <h2>Notes</h2>
      <% recipe.notes.forEach(function(note) { %>
      <div class="note-item"><% if (note.title && note.title.trim()) { %>
        <strong><%= note.title %></strong><br>
        <% } %><%- note.text %>
      </div>
      <% }); %>
    </div>
    <% } %>

    <% if (locals.options && options.showSource && recipe.orgURL) { %>
    <div class="recipe-footer">
      <p><%= locals.sourceDisplay || recipe.orgURL %></p>
    </div>
    <% } %>
  </div>
</body>

</html>
